{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "name", "strategy", "stage_plan", "health_gates", "rollback_requirement"],
  "properties": {
    "schema_version": {"const": "v1"},
    "name": {"type": "string", "minLength": 1, "maxLength": 160},
    "strategy": {"const": "fixed_wave"},
    "selector": {"type": "object"},
    "stage_plan": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"type": "integer", "minimum": 1, "maximum": 100}},
    "health_gates": {"type": "object", "additionalProperties": {"type": ["number", "boolean"]}},
    "max_offline_fraction": {"type": "number", "minimum": 0, "maximum": 1},
    "telemetry_freshness_sec": {"type": "integer", "minimum": 1},
    "min_observation_sec": {"type": "integer", "minimum": 1},
    "two_person_approval": {"type": "boolean"},
    "require_iot_evidence": {"type": "boolean"},
    "rollback_requirement": {"enum": ["required", "allow_first_install"]}
  },
  "additionalProperties": false
}
