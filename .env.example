# Runtime
EDGEFLEET_ENV=development
EDGEFLEET_HOST=127.0.0.1
EDGEFLEET_PORT=8080
EDGEFLEET_PUBLIC_URL=http://localhost:8080
EDGEFLEET_LOG_LEVEL=info
EDGEFLEET_LOG_FORMAT=pretty
EDGEFLEET_WORKER_ENABLED=true
EDGEFLEET_WORKER_CONCURRENCY=1

# Tenant management
SELF_REGISTRATION_ENABLED=true
DEFAULT_TENANT_NAME=Default
DEFAULT_TENANT_LEGAL_NAME=Default
DEFAULT_TENANT_TIMEZONE=UTC

# Security. Development setup generates blank values into ignored local-secrets/runtime.env.
SESSION_ENCRYPTION_KEY=
CREDENTIAL_ENCRYPTION_KEY=
CURSOR_HMAC_KEY=
TRUSTED_PROXY_CIDRS=127.0.0.1/32
PRIVATE_ADAPTER_CIDRS=

# Storage, standalone default
STORAGE_BACKEND=sqlite
SQLITE_PATH=./data/edgefleet.db
SQLITE_BUSY_TIMEOUT_MS=5000
DATABASE_URL=
DATABASE_POOL_SIZE=20
# Later production Compose only
POSTGRES_DB=edgefleet
POSTGRES_USER=edgefleet
POSTGRES_PASSWORD=

# Artifact and evidence storage
ARTIFACT_STORE_PATH=./data/artifacts
ARTIFACT_TEMP_PATH=./data/tmp
ARTIFACT_MAX_BYTES=104857600
ARTIFACT_MIN_FREE_BYTES=2147483648
TRACE_STORE_PATH=./data/traces
EXPORT_STORE_PATH=./data/exports

# Release defaults
DEFAULT_STAGE_PERCENTAGES=1,5,20,50,100
DEFAULT_MIN_OBSERVATION_SECONDS=900
DEFAULT_TELEMETRY_FRESHNESS_SECONDS=120
DEFAULT_CONVERGENCE_TARGET=0.98
DEFAULT_MAX_OFFLINE_FRACTION=0.20
COMMAND_EXPIRY_SECONDS=604800

# Simulator and replay
SIMULATOR_MAX_DEVICES=100000
SIMULATOR_MAX_EVENTS=10000000
SIMULATOR_WORKER_CONCURRENCY=1
BENCHMARK_CORPUS_PATH=./fixtures/benchmarks/v1/manifest.json
REPLAY_CHECKPOINT_INTERVAL=10000

# Optional IoT Sensor Data Aggregator, disabled by default
IOT_AGGREGATOR_ENABLED=false
IOT_AGGREGATOR_URL=http://localhost:3000
IOT_AGGREGATOR_API_KEY=
IOT_AGGREGATOR_REQUIRED_FOR_PROMOTION=false
IOT_AGGREGATOR_FIXTURE_MODE=true

# Optional Notification Hub, disabled by default
NOTIFICATION_HUB_ENABLED=false
NOTIFICATION_HUB_URL=http://localhost:3847
NOTIFICATION_HUB_API_KEY=
NOTIFICATION_HUB_FIXTURE_MODE=true

# Optional Workflow Automation Engine, disabled by default
WORKFLOW_ENGINE_ENABLED=false
WORKFLOW_ENGINE_URL=http://localhost:8000
WORKFLOW_ENGINE_API_KEY=
WORKFLOW_ENGINE_WORKFLOW_ID=
WORKFLOW_ENGINE_FIXTURE_MODE=true

# Observability, disabled external exporters by default
METRICS_BIND_HOST=127.0.0.1
METRICS_PORT=9090
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
